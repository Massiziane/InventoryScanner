generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String    @id @default(cuid())
  name        String
  barcode     String    @unique
  sku         String?
  price       Decimal   @db.Decimal(10, 2)
  stock       Int       @default(0)
  location    String?
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lotItems    LotItem[]
  scans       ScanLog[]
}

model Lot {
  id        String    @id @default(cuid())
  name      String
  location  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  items     LotItem[]
}

model LotItem {
  id        String   @id @default(cuid())
  lotId     String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([lotId, productId])
}

model ScanLog {
  id        String     @id @default(cuid())
  productId String?
  barcode   String
  action    ScanAction
  quantity  Int        @default(1)
  createdAt DateTime   @default(now())
  product   Product?   @relation(fields: [productId], references: [id])
}

enum ScanAction {
  ADD_STOCK
  REMOVE_STOCK
  SALE
  CHECK
}
